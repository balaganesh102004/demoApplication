{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "server/vercel-handler.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/vercel-handler.js" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
